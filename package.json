{
  "name": "ai-sales-agent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,worker \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run worker -w apps/api",
    "db:generate": "npm run db:generate -w packages/database",
    "db:migrate": "npm run db:migrate -w packages/database",
    "db:studio": "npm run db:studio -w packages/database"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
