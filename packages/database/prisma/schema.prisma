generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStage {
  NEW
  CONTACTED
  INTERESTED
  WON
  LOST
  DO_NOT_CONTACT
}

enum LeadMessageChannel {
  EMAIL
  LINKEDIN
}

enum LeadMessageDirection {
  INBOUND
  OUTBOUND
}

enum LeadMessageStatus {
  DRAFT
  SENT
  RECEIVED
}

model Organization {
  id                  String              @id @default(cuid())
  name                String
  websiteUrl          String?
  industry            String?
  description         String?
  services            String[]            @default([])
  differentiation     String?
  targetIndustries    String[]            @default([])
  targetTitles        String[]            @default([])
  locations           String[]            @default([])
  companySize         String?
  customerDescription String?
  onboardingCompleted Boolean             @default(false)
  users               User[]
  leads               Lead[]
  invitations         TeamInvitation[]
  settings            WorkspaceSettings?
  linkedinConfig      LinkedinConfig?
  linkedinScripts     LinkedinScript[]
  linkedinLeads       LinkedinLead[]
  activityLogs        ActivityLog[]
  notifications       InAppNotification[]
  leadCommunications  LeadCommunication[]
  opportunities       Opportunity[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model User {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  passwordHash      String
  role              Role         @default(MEMBER)
  roleTitle         String?      @default("Chief Growth Officer & Co-Founder")
  timezone          String?      @default("(UTC-05:00) Eastern Time (US & Canada)")
  avatarUrl         String?
  passwordChangedAt DateTime     @default(now())
  tokenVersion      Int          @default(0)
  deletedAt         DateTime?
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  removedById       String?
  removedReason     String?
}

model TeamInvitation {
  id             String       @id @default(cuid())
  email          String
  name           String
  role           Role         @default(MEMBER)
  token          String       @unique
  expiresAt      DateTime
  invitedById    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  status      String    @default("PENDING")
  emailError  String?
  lastSentAt  DateTime?
  acceptedAt  DateTime?
  cancelledAt DateTime?

  @@unique([organizationId, email])
}

model WorkspaceSettings {
  id                          String       @id @default(cuid())
  organizationId              String       @unique
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Outreach strategy
  tone                        String       @default("professional")
  maxFollowUps                Int          @default(3)
  intervalDays                Int          @default(3)
  dailyCap                    Int          @default(40)
  weeklyLinkedinLimit         Int          @default(100)
  postingFrequency            String       @default("3x_week")
  outreachApproved            Boolean      @default(false)
  outreachApprovedAt          DateTime?
  // Approval rules
  approvalThreshold           Int          @default(92)
  requireApprovalNewEmails    Boolean      @default(true)
  requireApprovalVideoScripts Boolean      @default(true)
  requireApprovalReplies      Boolean      @default(true)
  requireApprovalFollowups    Boolean      @default(false)
  requireApprovalLinkedin     Boolean      @default(true)
  // Notifications (JSON array/map of rules)
  notificationRules           Json?
  // Usage & Limits + Test Mode
  sentToday                   Int          @default(14)
  aiSpendThisMonth            Float        @default(0)
  aiLimit                     Float        @default(5.0)
  requestsToday               Int          @default(38)
  requestsDailyLimit          Int          @default(250)
  testMode                    Boolean      @default(false)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
}

model LinkedinConfig {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Profile Optimizer
  profileUrl             String?
  offer                  String       @default("")
  audience               String       @default("")
  groundingFacts         Json?
  latestScore            Int          @default(0)
  latestReadAt           String?
  suggestions            Json?
  auditHistory           Json?
  // Content Engine settings
  remindAt               String       @default("08:30")
  avatar                 String       @default("")
  heygenConnected        Boolean      @default(false)
  contentSources         Json?
  // Engagement & Connections Outreach Strategy
  strategyAgreedOn       String       @default("")
  strategyWho            String       @default("")
  strategyPerDay         Int          @default(0)
  strategyMessage        String       @default("")
  strategyFollowUpDays   Int          @default(0)
  // LinkedIn Account connection metadata
  accountConnected       Boolean      @default(false)
  accountName            String?
  linkedinMemberUrn      String?
  linkedinAccessToken    String?
  linkedinRefreshToken   String?
  linkedinTokenExpiresAt DateTime?
  linkedinScopes         String[]     @default([])
  oauthStateHash         String?      @unique
  oauthStateExpiresAt    DateTime?
  oauthStateUserId       String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model LinkedinScript {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String       @default("needs_approval")
  draftNo        Int          @default(1)
  source         String
  sourceUrl      String       @default("")
  date           String
  title          String
  hook           String
  points         String[]     @default([])
  cta            String
  seconds        Int          @default(40)
  words          Int          @default(100)
  scheduledFor   String?
  postedAt       String?
  postUrl        String?
  postDeleted    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model LinkedinLead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  role           String
  company        String
  source         String       @default("buyer")
  status         String       @default("suggested")
  reason         String
  reasonKind     String       @default("fit")
  note           String
  url            String?
  crmLeadId      String?      @unique
  crmLead        Lead?        @relation("LinkedinLeadToCrmLead", fields: [crmLeadId], references: [id], onDelete: SetNull)
  sentAt         String?
  connectedAt    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, source])
}

model Lead {
  id             String              @id @default(cuid())
  name           String
  email          String?
  company        String?
  jobTitle       String?
  source         String?
  notes          String?
  linkedinUrl    String?
  websiteUrl     String?
  nextFollowUpAt DateTime?
  archivedAt     DateTime?
  stage          LeadStage           @default(NEW)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communications LeadCommunication[]
  linkedinLead   LinkedinLead?       @relation("LinkedinLeadToCrmLead")
  opportunity    Opportunity?        @relation("OpportunityToLead")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, stage])
  @@index([organizationId, archivedAt])
}

model LeadCommunication {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel        LeadMessageChannel
  direction      LeadMessageDirection
  status         LeadMessageStatus
  subject        String?
  body           String               @db.Text
  occurredAt     DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([organizationId, status, occurredAt])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String       @default("research")
  title          String
  leadId         String?
  leadName       String?
  leadContext    String       @default("")
  agent          String       @default("General Agent")
  status         String       @default("completed")
  startedAt      DateTime?
  scheduledFor   DateTime?
  durationSec    Int?
  retries        Int          @default(0)
  maxRetries     Int          @default(3)
  output         String?
  error          String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model InAppNotification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String       @default("system")
  title          String
  body           String
  read           Boolean      @default(false)
  href           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, read, createdAt])
}


model Opportunity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  company        String
  type           String       @default("client_project")
  sourceId       String
  sourceLabel    String
  postedAt       DateTime     @default(now())
  relevance      Int          @default(80)
  signals        String       @db.Text
  budget         String?
  location       String?
  url            String
  status         String       @default("open")
  leadId         String?      @unique
  lead           Lead?        @relation("OpportunityToLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, sourceId])
  @@index([organizationId, relevance])
  @@index([organizationId, postedAt])
  @@index([organizationId, url])
}
