generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStage {
  NEW
  REVIEWED
  CONTACTED
  INTERESTED
  WON
  LOST
}

model Organization {
  id                  String             @id @default(cuid())
  name                String
  websiteUrl          String?
  industry            String?
  description         String?
  services            String[]           @default([])
  differentiation     String?
  targetIndustries    String[]           @default([])
  targetTitles        String[]           @default([])
  locations           String[]           @default([])
  companySize         String?
  customerDescription String?
  onboardingCompleted Boolean            @default(false)
  users               User[]
  leads               Lead[]
  invitations         TeamInvitation[]
  settings            WorkspaceSettings?
  linkedinConfig      LinkedinConfig?
  linkedinScripts     LinkedinScript[]
  linkedinLeads       LinkedinLead[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model User {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  passwordHash      String
  role              Role         @default(MEMBER)
  roleTitle         String?      @default("Chief Growth Officer & Co-Founder")
  timezone          String?      @default("(UTC-05:00) Eastern Time (US & Canada)")
  avatarUrl         String?
  passwordChangedAt DateTime     @default(now())
  tokenVersion      Int          @default(0)
  deletedAt         DateTime?
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model TeamInvitation {
  id             String       @id @default(cuid())
  email          String
  name           String
  role           Role         @default(MEMBER)
  token          String       @unique
  expiresAt      DateTime
  invitedById    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
}

model WorkspaceSettings {
  id                          String       @id @default(cuid())
  organizationId              String       @unique
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Outreach strategy
  tone                        String       @default("professional")
  maxFollowUps                Int          @default(3)
  intervalDays                Int          @default(3)
  dailyCap                    Int          @default(40)
  weeklyLinkedinLimit         Int          @default(100)
  postingFrequency            String       @default("3x_week")
  outreachApproved            Boolean      @default(false)
  outreachApprovedAt          DateTime?
  // Approval rules
  approvalThreshold           Int          @default(92)
  requireApprovalNewEmails    Boolean      @default(true)
  requireApprovalVideoScripts Boolean      @default(true)
  requireApprovalReplies      Boolean      @default(true)
  requireApprovalFollowups    Boolean      @default(false)
  requireApprovalLinkedin     Boolean      @default(true)
  // Notifications (JSON array/map of rules)
  notificationRules           Json?
  // Usage & Limits + Test Mode
  sentToday                   Int          @default(14)
  aiSpendThisMonth            Float        @default(0)
  aiLimit                     Float        @default(5.0)
  requestsToday               Int          @default(38)
  requestsDailyLimit          Int          @default(250)
  testMode                    Boolean      @default(false)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
}

model LinkedinConfig {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Profile Optimizer
  profileUrl           String?
  offer                String       @default("I build AI agents for B2B SaaS outbound")
  audience             String       @default("")
  groundingFacts       Json?
  latestScore          Int          @default(84)
  latestReadAt         String?
  suggestions          Json?
  auditHistory         Json?
  // Content Engine settings
  remindAt             String       @default("08:30")
  avatar               String       @default("Ahmed Avatar v2")
  heygenConnected      Boolean      @default(true)
  contentSources       Json?
  // Engagement & Connections Outreach Strategy
  strategyAgreedOn     String       @default("2026-10-10")
  strategyWho          String       @default("VPs and Heads of Sales at B2B SaaS companies, 50-500 employees, US and UK")
  strategyPerDay       Int          @default(15)
  strategyMessage      String       @default("Hi {first_name}, I saw your post on {topic}. I work with SaaS sales teams on outbound, would be glad to connect.")
  strategyFollowUpDays Int          @default(3)
  // LinkedIn Account connection metadata
  accountConnected     Boolean      @default(true)
  accountName          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model LinkedinScript {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String       @default("needs_approval")
  draftNo        Int          @default(1)
  source         String
  sourceUrl      String       @default("")
  date           String
  title          String
  hook           String
  points         String[]     @default([])
  cta            String
  seconds        Int          @default(40)
  words          Int          @default(100)
  scheduledFor   String?
  postedAt       String?
  postUrl        String?
  postDeleted    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model LinkedinLead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  role           String
  company        String
  source         String       @default("buyer")
  status         String       @default("suggested")
  reason         String
  reasonKind     String       @default("fit")
  note           String
  url            String?
  sentAt         String?
  connectedAt    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, source])
}

model Lead {
  id             String       @id @default(cuid())
  name           String
  email          String?
  company        String?
  jobTitle       String?
  source         String?
  notes          String?
  stage          LeadStage    @default(NEW)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, stage])
}
