generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStage {
  NEW
  REVIEWED
  CONTACTED
  INTERESTED
  WON
  LOST
}

enum ApprovalType {
  NEW_EMAIL
  VIDEO_SCRIPT
  REPLY
  FOLLOW_UP
  LINKEDIN_PROFILE
  LINKEDIN_POST
  CONNECTION_NOTE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  AUTO_APPROVED
  REJECTED
}

model Organization {
  id                  String              @id @default(cuid())
  name                String
  websiteUrl          String?
  industry            String?
  description         String?
  services            String[]            @default([])
  differentiation     String?
  targetIndustries    String[]            @default([])
  targetTitles        String[]            @default([])
  locations           String[]            @default([])
  companySize         String?
  customerDescription String?
  onboardingCompleted Boolean             @default(false)
  users               User[]
  leads               Lead[]
  invitations         TeamInvitation[]
  settings            WorkspaceSettings?
  approvals           ApprovalItem[]
  activityLogs        ActivityLog[]
  notifications       InAppNotification[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model User {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  passwordHash      String
  role              Role         @default(MEMBER)
  roleTitle         String?      @default("Chief Growth Officer & Co-Founder")
  timezone          String?      @default("(UTC-05:00) Eastern Time (US & Canada)")
  avatarUrl         String?
  passwordChangedAt DateTime     @default(now())
  tokenVersion      Int          @default(0)
  deletedAt         DateTime?
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model TeamInvitation {
  id             String       @id @default(cuid())
  email          String
  name           String
  role           Role         @default(MEMBER)
  token          String       @unique
  expiresAt      DateTime
  invitedById    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
}

model WorkspaceSettings {
  id                          String       @id @default(cuid())
  organizationId              String       @unique
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Outreach strategy
  tone                        String       @default("professional")
  maxFollowUps                Int          @default(3)
  intervalDays                Int          @default(3)
  dailyCap                    Int          @default(40)
  weeklyLinkedinLimit         Int          @default(100)
  postingFrequency            String       @default("3x_week")
  outreachApproved            Boolean      @default(false)
  outreachApprovedAt          DateTime?
  // Approval rules
  approvalThreshold           Int          @default(92)
  requireApprovalNewEmails    Boolean      @default(true)
  requireApprovalVideoScripts Boolean      @default(true)
  requireApprovalReplies      Boolean      @default(true)
  requireApprovalFollowups    Boolean      @default(false)
  requireApprovalLinkedin     Boolean      @default(true)
  // Notifications (JSON array/map of rules)
  notificationRules           Json?
  // Usage & Limits + Test Mode
  sentToday                   Int          @default(14)
  aiSpendThisMonth            Float        @default(0)
  aiLimit                     Float        @default(5.0)
  requestsToday               Int          @default(38)
  requestsDailyLimit          Int          @default(250)
  testMode                    Boolean      @default(false)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
}

model ApprovalItem {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            ApprovalType
  status          ApprovalStatus @default(PENDING)
  title           String
  subtitle        String?
  content         Json
  confidence      Int            @default(90)
  leadId          String?
  createdById     String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  testMode        Boolean        @default(false)
  dispatchedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, type])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  status         String       @default("completed")
  title          String
  text           String
  jobName        String?
  jobId          String?
  attempts       Int          @default(1)
  maxAttempts    Int          @default(3)
  error          String?
  metadata       Json?
  testMode       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model InAppNotification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleId         String       @default("system")
  title          String
  message        String
  tone           String       @default("primary")
  read           Boolean      @default(false)
  link           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, read, createdAt])
}

model Lead {
  id             String       @id @default(cuid())
  name           String
  email          String?
  company        String?
  jobTitle       String?
  source         String?
  notes          String?
  stage          LeadStage    @default(NEW)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, stage])
}
